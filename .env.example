# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored):
#   cp .env.example .dev.vars
# In production, set them with `npx wrangler secret put <NAME>` instead.

# GitHub personal access token
# Generate at: https://github.com/settings/tokens (public_repo scope is enough)
GITHUB_TOKEN=your_github_token_here

# Anthropic API key (a standard key, not an Admin API key)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
