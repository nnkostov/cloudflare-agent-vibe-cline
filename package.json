{
  "name": "github-ai-intelligence-agent",
  "version": "1.12",
  "description": "AI-powered GitHub repository intelligence agent for VC investment opportunities",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npm run dev:dashboard & npm run dev:worker",
    "dev:worker": "wrangler dev",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build": "npm run build:dashboard",
    "build:dashboard": "cd dashboard && npm run build",
    "deploy": "node scripts/auto-version.js && npm run build:dashboard && wrangler deploy --env=\"\"",
    "test": "vitest",
    "test:ci": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@cloudflare/kv-asset-handler": "^0.4.0",
    "@octokit/rest": "^20.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@miniflare/d1": "^2.14.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "dotenv": "^17.2.1",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
